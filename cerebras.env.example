# Copy this file to `cerebras.env` and fill in your real keys.
#   cp cerebras.env.example cerebras.env
# The run scripts do `source cerebras.env`. cerebras.env is gitignored and must
# NEVER be committed. At least CEREBRAS_KEY_1 is required; add 2-4 if you have
# multiple accounts (the harness round-robins across them to dodge rate limits).

export CEREBRAS_KEY_1=your_key_here
export CEREBRAS_KEY_2=
export CEREBRAS_KEY_3=
export CEREBRAS_KEY_4=
